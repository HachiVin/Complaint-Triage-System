# Copy to .env and fill in. Never commit .env.
MODEL_DIR=models/baseline
# 1 = load the fictional demo reviews when the database is empty
SEED_DEMO=1
POSTGRES_PASSWORD=change-me
# Optional read-only connection for the agent (see sql/readonly_role.sql)
# AGENT_DATABASE_URL=postgresql://agent_ro:PASSWORD@db:5432/triage
# LLM for /api/ask: any OpenAI-compatible endpoint. Groq free tier by default; get a key at console.groq.com
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
RATE_LIMIT_CLASSIFY=60
RATE_LIMIT_ASK=5
